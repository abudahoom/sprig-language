# Lesson 8: mini project — student score report
# Replace these values to turn this into your own program.
let student = "Ari"
let scores = [88, 72, 95, 61, 84]

fn letter_grade(score) {
    if score >= 90 {
        return "A"
    } else if score >= 80 {
        return "B"
    } else if score >= 70 {
        return "C"
    } else if score >= 60 {
        return "D"
    }
    return "F"
}

fn average(values) {
    let total = 0
    for value in values {
        total = total + value
    }
    return total / len(values)
}

print("Score report for", student)
print("--------------------")

for score in scores {
    print(score, "->", letter_grade(score))
}

let final_average = average(scores)
print("Average:", final_average)
print("Final grade:", letter_grade(final_average))

